# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# GROQ_API_KEY: the offline LLM step (pipeline/classify.py). For the hosted app, put keys in Streamlit secrets instead.
GROQ_API_KEY=
# Optional: a separate key for the Ask tab (config/ask.yaml); if empty, GROQ_API_KEY is used.
GROQ_ASK_API_KEY=
